# 复制为 .env.ci.local 使用（已被 git-ignore）。
# MINI_REVIEW_API_KEY 必填：向本项目后端（match.oryjk.cn）mini-review 登记库申请审核版本号的静态密钥，
# 与后端环境变量 MINI_REVIEW_API_KEY 保持一致（后端 .env.example 有说明）。
MINI_REVIEW_API_KEY=

# 可选覆盖，默认值见 scripts/sync-manifest-version.mjs
# MINI_REVIEW_API_URL=https://match.oryjk.cn/api/v1
# MINI_REVIEW_PROJECT_CODE=football_insight_mini

# 纯本地离线构建（不登记版本号、不改版本基线）时设为 1
# MINI_REVIEW_SKIP=1

# 上传私钥路径覆盖；默认读项目根 private.<appid>.key
# MINI_CI_PRIVATE_KEY_PATH=./private.wxc61da17a97f6eb1b.key
