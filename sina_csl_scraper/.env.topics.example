# Source config is passed with --config; no secrets belong in that JSON.
FI_TOPIC_LLM_BASE_URL=https://api.kimi.com/coding/v1
FI_TOPIC_LLM_MODEL=k3-256k
FI_TOPIC_LLM_API_KEY=
# Edge TTS voice (default: zh-CN-YunyangNeural):
FI_EDGE_TTS_VOICE=zh-CN-YunyangNeural
# FI_AUDIO_CONVERTER=/absolute/path/to/ffmpeg
FI_MINIO_ENDPOINT=https://oryjk.cn:82/minio
FI_MINIO_BUCKET=football-insight
FI_MINIO_REGION=us-east-1
FI_MINIO_ACCESS_KEY=
FI_MINIO_SECRET_KEY=
# Or keep MinIO credentials on an existing scraper host:
# FI_TOPIC_MINIO_SSH_HOST=local233
# FI_TOPIC_MINIO_REMOTE_PROJECT=/home/betalpha/projects/football_insight/sina_csl_scraper
# FI_DATABASE_URL=postgresql://...
