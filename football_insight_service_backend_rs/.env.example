PORT=8080

# Deployment Configuration
# Used by deploy_peiqian_docker.sh; keep the real value only in local .env.
HARBOR_PASSWORD=

DATABASE_URL=postgres://football_app:change_me@127.0.0.1:5432/football_data
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_MIN_CONNECTIONS=3
DB_POOL_ACQUIRE_TIMEOUT_SECS=5
DB_POOL_IDLE_TIMEOUT_SECS=90
DB_POOL_MAX_LIFETIME_SECS=600
RUST_LOG=info,sqlx=warn
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me-to-an-independent-random-secret-at-least-32-characters
ADMIN_OWNER_USERNAME=owner
ADMIN_OWNER_PASSWORD=change-me-to-a-strong-password
ADMIN_OWNER_DISPLAY_NAME=Football Insight Owner
# 小程序发版登记接口（POST /api/v1/mini-review/allocate、PUT review-status）的静态密钥；
# 为空时登记接口不开放。与 football_insight_mini/.env.ci.local 的 MINI_REVIEW_API_KEY 保持一致。
MINI_REVIEW_API_KEY=
# 可在小程序「我的 → 设置」切换当前版本审核状态的用户 UUID 白名单（逗号分隔）；
# 与 football_insight_mini 的 VITE_PRODUCT_OWNER_USER_ID 保持一致。
MINI_REVIEW_CONTROL_USER_IDS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
AI_CHAT_MODEL=glm-5.1
WECHAT_APP_ID=change-me
WECHAT_APP_SECRET=change-me
WECHAT_MINI_APP_ID=change-me
WECHAT_MINI_APP_SECRET=change-me
WECHAT_WEBHOOK_TOKEN=change-me
WECHAT_ENCODING_AES_KEY=change-me
REDIS_URL=redis://127.0.0.1:6379
WECHAT_PAY_MCH_ID=change-me
WECHAT_PAY_API_KEY=change-me
PUBLIC_BASE_URL=https://match.oryjk.cn
